_satellite.__registerScript('https://assets.adobedtm.com/87fc8b53a8b1/9eca36d8137d/cc35766b462d/RCe6e88fe1f97f42da89a1a83160e61892-source.min.js', "<script>\n    (function() {\n        function getCookie(name) {\n            const value = `; ${document.cookie}`;\n            const parts = value.split(`; ${name}=`);\n            if (parts.length === 2) return parts.pop().split(';').shift();\n            return null;\n        }\n\n        function setCookie(value, days) {\n            const expires = new Date(Date.now() + (days * 86400000)).toUTCString();\n            const cookieString = 'ecid=' + value + '; expires=' + expires + '; path=/; Secure;';\n            document.cookie = cookieString;\n        }\n        if (!getCookie(\"ecid\")) {\n            alloy(\"getIdentity\", {\n                namespaces: [\"ECID\"]\n            }).then(function(response) {\n                let ecid = response.identity && response.identity.ECID;\n                if (ecid) {\n                    setCookie(ecid, 365);\n                }\n            });\n        }\n    })();\n</script>");